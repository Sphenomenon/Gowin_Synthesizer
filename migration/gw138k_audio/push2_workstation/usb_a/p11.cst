// Keep the audio PLL RESET cone compact at a site used by accepted P10.
// P10 Prj1.tr places this helper's enable_r_1_s0 at R39C72[0][A]
// with audio PLL at PLL_B[2]; its full PLL_INIT maximum was 9.808 ns.
// No logic/clock change or timing exception: VO/SDF still must meet 10 ns.
INS_LOC "u_audio_clock/g_hardware.u_pll/u_pll_init/enable_r_1_s0" R39C72;
INS_LOC "u_audio_clock/g_hardware.u_pll/u_pll_init/state_0_s0" R39C72;
INS_LOC "u_audio_clock/g_hardware.u_pll/u_pll_init/state_1_s0" R39C72;
INS_LOC "u_audio_clock/g_hardware.u_pll/u_pll_init/state_2_s0" R39C72;
INS_LOC "u_audio_clock/g_hardware.u_pll/u_pll_init/pll_reset_s" R39C72;
