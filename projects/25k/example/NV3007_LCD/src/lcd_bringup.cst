// Ball assignments: project schematic FPC1 and Sipeed 52300 core CLK.
IO_LOC "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "lcd_mosi" H8;
IO_LOC "lcd_sck" K5;
IO_LOC "lcd_dc" L5;
IO_LOC "lcd_ncs" J5;
IO_LOC "lcd_te" H5;
IO_PORT "lcd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 SLEW_RATE=SLOW;
IO_PORT "lcd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 SLEW_RATE=SLOW;
IO_PORT "lcd_dc" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 SLEW_RATE=SLOW;
IO_PORT "lcd_ncs" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 SLEW_RATE=SLOW;
IO_PORT "lcd_te" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
