// Pin names and UART direction follow U3 (module viewpoint).
IO_LOC "clk_50mhz" E2;
IO_PORT "clk_50mhz" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "restart_n" L10;
IO_PORT "restart_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "module_uart_tx" J8;
IO_PORT "module_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "usb1_dp" L6;
IO_PORT "usb1_dp" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "usb1_dm" K6;
IO_PORT "usb1_dm" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "module_uart_rx" K9;
IO_PORT "module_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "module_bt_dis_n" K8;
IO_PORT "module_bt_dis_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "led_ready" E8;
IO_PORT "led_ready" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "led_done" D7;
IO_PORT "led_done" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
