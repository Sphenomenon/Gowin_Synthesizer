// Schematic SW1/SW2 and FPC1, GW5A-LV25MG121NC1/I0.
IO_LOC "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "sw1_a" K10;
IO_LOC "sw1_b" L8;
IO_LOC "sw1_key_n" L10;
IO_LOC "sw2_a" L7;
IO_LOC "sw2_b" K7;
IO_LOC "sw2_key_n" J7;
// External 10k pull-ups are fitted on all six encoder contacts.
IO_PORT "sw1_a" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sw1_b" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sw1_key_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sw2_a" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sw2_b" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sw2_key_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "lcd_mosi" H8;
IO_LOC "lcd_sck" K5;
IO_LOC "lcd_dc" L5;
IO_LOC "lcd_ncs" J5;
IO_LOC "lcd_te" H5;
IO_PORT "lcd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "lcd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "lcd_dc" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "lcd_ncs" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;
IO_PORT "lcd_te" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
