// Isolated 48 kHz migration candidate; copied DDR/HDMI constraints from Prj1.
// Target GW5AST-LV138PG484AC2/I1 / GW5AST-138C, NEO Dock 31005.
// G1 F12 -> J9 pin 7 = PMOD0_IO4 = P16. GND -> J9 pin 3 or 4.
// Same signal also reaches J14 pin 6; confirm no attached module drives it.
// Physical wiring / Bank4 3.3V (TP22) must be confirmed before SRAM download.
// Read-only diagnostics use BL616 RX/U15; V14 remains unused, G1 stays on P16.
IO_LOC "debug_uart_tx" U15;
IO_PORT "debug_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "midi_rx_i" P16;
IO_PORT "midi_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// NEO Dock-138K 31005 and SOM 30354; see docs/hardware.md, not legacy LED pinouts.
IO_LOC "clk_50m" V22;
IO_PORT "clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "button1_n" AB13;
IO_PORT "button1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "hp_bck" Y17;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC "hp_ws" AB17;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC "hp_din" AA16;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC "pa_en" AB16;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "hdmi_tx_en" K14;
IO_PORT "hdmi_tx_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
// J29 pin 19, divided by R169/R168 before reaching the FPGA.
IO_LOC "hdmi_hpd" K13;
IO_PORT "hdmi_hpd" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// ELVDS_OBUF consumes each P,N pair; constrain its positive port only.
IO_LOC "tmds_data_p[0]" J14,H14;
IO_PORT "tmds_data_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_data_p[1]" J15,H15;
IO_PORT "tmds_data_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_data_p[2]" K17,J17;
IO_PORT "tmds_data_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_clk_p" G15,G16;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;

