IO_LOC "pc_uart_rx_i" V14;
IO_PORT "pc_uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Tang Mega 138K C + NEO Dock 31005, physical USB-A between HDMI and Micro-USB.
// Upstream mega.cst corrects the schematic. Confirmed on this board by actual
// Logitech 046D:C53F enumeration, board_reference_20260911_025311_816541.
// Logical usb1_* names retained; physical D+/D- are H13/G13, not M15/M16.
IO_LOC "usb1_dp" H13;
IO_LOC "usb1_dn" G13;
IO_PORT "usb1_dp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "usb1_dn" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Physical mapping cross-checked with supplied CH569 HSPI16 CST and 31005 schematic.
// Keep the audio PLL RESET cone compact at a site used by accepted P10.
// NEO Dock 31005 J31 micro-SD in SPI mode: DAT0=MISO, CMD=MOSI,
// CLK=SCK and DAT3=CS.  Socket pull-ups remain enabled during reset.
IO_LOC "sd_miso" AA15;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sd_mosi" Y16;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "sd_sck" V15;
IO_PORT "sd_sck" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "sd_cs_n" W15;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// P10 Prj1.tr places this helper's enable_r_1_s0 at R39C72[0][A]
// with audio PLL at PLL_B[2]; its full PLL_INIT maximum was 9.808 ns.
// No logic/clock change or timing exception: VO/SDF still must meet 10 ns.
INS_LOC "u_audio_clock/g_hardware.u_pll/u_pll_init/enable_r_1_s0" R39C72[0][A];
INS_LOC "u_audio_clock/g_hardware.u_pll/u_pll_init/state_0_s0" R39C72[1][A];
INS_LOC "u_audio_clock/g_hardware.u_pll/u_pll_init/state_1_s0" R39C72[1][B];
INS_LOC "u_audio_clock/g_hardware.u_pll/u_pll_init/state_2_s0" R39C72[2][A];

// Workstation video PLL helper locality; no I/O/pin or PLL configuration change.
// Reuse the existing reference-helper region; constrain only dynamic pin drivers.
GROUP workstation_reference_pll_helper = { "u_video/u_clock/g_hardware.u_pll/u_reference/u_pll_init/RomDreg*" "u_video/u_clock/g_hardware.u_pll/u_reference/u_pll_init/state*" "u_video/u_clock/g_hardware.u_pll/u_reference/u_pll_init/enable_r*" "u_video/u_clock/g_hardware.u_pll/u_reference/u_pll_init/pll_reset*" };
GRP_LOC workstation_reference_pll_helper R[100:108]C[24:44];
