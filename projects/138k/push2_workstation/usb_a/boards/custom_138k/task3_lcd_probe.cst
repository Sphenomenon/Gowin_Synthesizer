// Explicit task3 LCD n->n experimental probe only. Never merge into old profiles implicitly.
// Same pin names on M/W; ROLE_M selects complementary direction in RTL.
// Runtime and compile enables default0; all25 pads otherwise high impedance.
// Physical VCCIO/power/continuity/CDC/timing and measured budget remain unaccepted.
IO_LOC "lcd_r[0]" N22;
IO_PORT "lcd_r[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "lcd_r[1]" M22;
IO_PORT "lcd_r[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
