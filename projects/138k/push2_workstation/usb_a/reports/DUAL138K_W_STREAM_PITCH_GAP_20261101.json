  "findings": [
    {
      "id": "contract",
      "conclusion": "task2 section5.1 explicitly requires W full Pitch/Delay/Chorus/Reverb."
    },
    {
      "id": "current_streaming_path",
      "conclusion": "Actual W20 prepared D-only event source fixes pitch_q20_o at Q20 unity. Its real PCM effects instance accepts PCM, gains, mask/order and delay-send, but no PCM pitch control. This does not implement streaming PCM pitch."
    },
    {
      "id": "official_25k_entry",
      "conclusion": "Firmware decodes Pitch Bend as kind4 globally but WORKSTATION_WORKER_DEMO accepts only momentary keys or a whitelist of kind2 CCs; kind4 is rejected. The current formal W adapter has no pitch command acceptance."
    },
    {
      "id": "legacy_D_pitch",
      "conclusion": "The maintained sampler voice pitch_ratio(note,root) advances stored-sample phase with voice/ADSR/descriptor state. It is sample playback transposition, not continuous Bluetooth PCM pitch, and reintroducing it would violate W engine retirement."
    },
    {
      "id": "existing_SRC",
      "conclusion": "AE350 PCM owner adaptive Q24 SRC corrects source-clock drift near unity by about +/-2000ppm; this is not a performance pitch effect. Simply changing its ratio for semitone-scale pitch would accumulate queue underflow/overflow for a continuous source."
    },
    {
      "id": "existing_expression",
      "conclusion": "workstation_rate_pitch_expression computes a frequency ratio for oscillators with no PCM stream input/output; it is not a ready streaming pitch processor."
    },
    {
      "id": "age",
      "conclusion": "Frozen W19 source already fixes D-only pitch to unity, so the identified gap predates the W20 momentary-tail change; no claim of newly introduced bug."
    },
    {
      "id": "search_limit",
      "conclusion": "No named pitch-shift/phase-vocoder/time-stretch implementation matched in the maintained usb_a/rtl tree. This bounded search does not prove absence throughout all historical/vendor trees."
    },
    {
      "id": "next_boundary",
      "conclusion": "A separate source/candidate change is needed for real continuous stereo PCM pitch and official25K controls, with both rates, bounded latency, cancellation/history/rate semantics and sustained input/output validation. Do not mutate frozen W20 or claim present task2 completion."
    }
  ],
