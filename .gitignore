# This workspace contains several historical/reference trees.  The Git
# repository tracks the 138K host and 25K panel under projects/, plus shared
# planning documents. Generated outputs stay local. The old migration path
# is a tracked compatibility symlink, not a second source tree.
#
# Historical/reference trees are ignored wholesale below and the canonical
# first-party paths are re-admitted with '!' rules.  ORDER MATTERS: a '!' only
# re-admits a path excluded by an earlier rule, so do not reorder this block.
/fpga/
/Mega_138K/
/migration/*
!/migration/gw138k_audio
# Re-admit the 138K tree, then admit only these parts of it: README.md,
# scripts/, ae350/scripts/ and the whole push2_workstation/ workstation.
!/projects/138k/
projects/138k/*
!/projects/138k/README.md
!/projects/138k/example/
!/projects/138k/scripts/
!/projects/138k/ae350/
projects/138k/ae350/*
!/projects/138k/ae350/scripts/
!/projects/138k/push2_workstation/

# Build results, captures, and generated implementation databases.
**/results/
projects/138k/push2_workstation/usb_a/out/
!projects/138k/push2_workstation/results/
projects/138k/push2_workstation/results/*
!projects/138k/push2_workstation/results/workstation_20260911_174045_306332/
projects/138k/push2_workstation/results/workstation_20260911_174045_306332/*
!projects/138k/push2_workstation/results/workstation_20260911_174045_306332/Prj1/
!projects/138k/push2_workstation/results/workstation_20260911_174045_306332/Prj1/**
projects/138k/push2_workstation/results/workstation_20260911_174045_306332/Prj1/impl/
projects/138k/push2_workstation/results/workstation_20260911_174045_306332/Prj1/build/

**/impl/
**/build/
**/__pycache__/
*.pyc
*.vcd
*.fst
*.wlf
*.elf
*.bin
*.fs
*.vo
!projects/138k/push2_workstation/usb_a/vendor/ddr3_reference/ddr3_memory_interface.vo
*.vg
*.sdf
*.pr
*.db
*.p
*.rpt
*.rpt.html
*.tr
*.timing_paths
*.power.html
*.pin.html
*.log
*.tmp
projects/138k/push2_workstation/usb_a/LATEST_BUILD.txt

# Tool-local files and editor metadata.
*.gprj.user
.DS_Store

# Local tooling and stray artifacts.
a.out
.commandcode/
.zcodeignore

# Original RTL8723DS firmware inputs for independent controller-model regression.
!projects/138k/push2_workstation/usb_a/vendor/rtl8723ds_ble/firmware/*.bin

# Frozen upstream evidence is required by the BLE input manifest.
!projects/138k/push2_workstation/usb_a/vendor/rtl8723ds_ble/reports/utilization*.rpt
!projects/138k/push2_workstation/usb_a/vendor/rtl8723ds_ble/validation/portable/*.log

# Previously tracked PL acceptance logs move with the 138K source tree.
!projects/138k/push2_workstation/usb_a/reports/GW25K_PANEL_20261017_test.log
!projects/138k/push2_workstation/usb_a/reports/GW25K_PANEL_20261017_rtl_exchange.log
!projects/138k/push2_workstation/usb_a/reports/GW25K_PANEL_20261017_hotplug_test.log
!projects/138k/push2_workstation/usb_a/reports/GW25K_PANEL_20261017_generic_midi_test.log

# Native simulation scratch from the local functional pass.
projects/138k/push2_workstation/usb_a/reports/function_first_*/attach/
projects/138k/push2_workstation/usb_a/reports/function_first_*/gw25k_host/
projects/138k/push2_workstation/usb_a/reports/function_first_*/guide/

# Report evidence convention: under reports/, *.md / *.json / *.py / *.sv and
# resource/timing text summaries are tracked as dated evidence, while raw
# *.log and *.tr tool output stay local unless a specific file is re-admitted
# with '!' above.  MIDI_KEYBOARD reports follow the same json-first convention.
